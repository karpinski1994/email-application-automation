# ==========================================
# API Keys & Secrets
# ==========================================
# Copy this file to .env and fill in your actual keys.
# NEVER commit the actual .env file!

# Apify (Required for Job Scraping)
APIFY_API_KEY=apify_api_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# AnyMailFinder (Required for Email Discovery)
ANYMAILFINDER_API_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# LLM Provider (Required if using OpenAI, Optional if using local Ollama)
OPENAI_API_KEY=sk-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ==========================================
# Google / Gmail OAuth
# ==========================================
# NOTE: The system uses OAuth2, which requires a 'credentials.json' file 
# downloaded from Google Cloud Console. It does NOT use a simple API key 
# for Gmail drafting. 
# 
# Place your 'credentials.json' in the project root (it is gitignored).
#
# If you use other Google APIs that require a simple key, put it here:
# GOOGLE_API_KEY=AIzaXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX